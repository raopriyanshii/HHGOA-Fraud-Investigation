# Copy this file to .env and fill in the values from your own Savanna
# workspace yourself -- .env is gitignored, never commit real credentials,
# and never paste the secret into chat.
#
# Where each value comes from: open your Savanna workspace, click
# "Connect" -> "Connect from API". Savanna generates a ready-to-use code
# snippet with your workspace's real host and auth already filled in --
# copy the values out of that snippet rather than guessing.

# The workspace's REST endpoint, exactly as Savanna shows it in the
# Connect panel (e.g. https://<your-workspace-subdomain>.i.tgcloud.io --
# that example is illustrative only, copy YOUR actual value).
TG_HOST=

# The database secret you already created (pyTigerGraph's preferred auth
# method -- confirmed via the official pyTigerGraph README: "GSQL secret
# for token-based auth (preferred over username/password)"). This maps to
# the `gsqlSecret` connection parameter.
TG_GSQL_SECRET=

# Fallback only, if you'd rather not use the secret:
TG_USERNAME=
TG_PASSWORD=

# The name Savanna's Connect panel shows for your database/graph. You
# told me the database is "MyDatabase" -- Savanna's own docs distinguish
# a "database" (the storage the workspace attaches to) from the GSQL
# "graph" defined inside it, so this may or may not be the exact value
# pyTigerGraph's `graphname` parameter expects. The auto-generated Connect
# snippet will show the correct value directly; use that.
TG_GRAPH_NAME=MyDatabase

# Savanna is a TigerGraph Cloud instance -- pyTigerGraph needs this flag
# set for cloud-hosted connections (confirmed via the pyTigerGraph README).
TG_CLOUD=true

# G8: real Groq provider (src/agent/llm_providers/groq_provider.py).
# Get a key from https://console.groq.com/keys. Never commit a real
# value here -- .env itself is gitignored; this file is the template,
# always left blank.
GROQ_API_KEY=

# G8: real Gemini provider (src/agent/llm_providers/gemini_provider.py).
# Get a key from https://aistudio.google.com/apikey -- the Gemini API's
# free tier does not require a credit card. Never commit a real value
# here -- .env itself is gitignored; this file is the template, always
# left blank.
GEMINI_API_KEY=
